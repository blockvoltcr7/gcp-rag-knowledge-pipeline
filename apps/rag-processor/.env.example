# Google Cloud Platform Configuration
# Generated for development environment

# Project Configuration
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_CLOUD_STORAGE_BUCKET=your-gcp-project-id-rag-documents-dev
VERTEX_AI_LOCATION=us-central1

# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=5
DATABASE_TIMEOUT=60

# API Configuration
GEMINI_API_KEY=your-gemini-api-key

# Cloud Tasks Configuration
CLOUD_TASKS_QUEUE_NAME=rag-processing-queue-dev

# Service Configuration
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=debug
LOG_FORMAT=console
HOST=0.0.0.0

# RAG Processor Cloud Run Jobs Configuration (environment-aware allocation)
PROCESSOR_JOB_NAME=rag-processor-job-dev
CLOUD_RUN_JOBS_CPU=6
CLOUD_RUN_JOBS_MEMORY=8Gi
CLOUD_RUN_JOBS_PARALLELISM=10
CLOUD_RUN_JOBS_TIMEOUT=7200

# Cloud Build Configuration
CLOUD_BUILD_MACHINE_TYPE=E2_HIGHCPU_8
CLOUD_BUILD_DISK_SIZE_GB=200

# Thread and performance optimization (optimized for 6 CPU cores)
OMP_NUM_THREADS=6
OPENBLAS_NUM_THREADS=3
MKL_NUM_THREADS=4
NUMEXPR_NUM_THREADS=2
BLIS_NUM_THREADS=3
TOKENIZERS_PARALLELISM=false
TORCH_NUM_THREADS=6
OMP_WAIT_POLICY=PASSIVE

# Processing Configuration
CHUNK_SIZE=2000
CHUNK_OVERLAP=200

# Embedding Models
TEXT_EMBEDDING_MODEL=gemini-embedding-001
TEXT_EMBEDDING_DIMENSIONS=3072
MULTIMODAL_EMBEDDING_MODEL=multimodalembedding@001
MULTIMODAL_EMBEDDING_DIMENSIONS=1408

# Video Processing Configuration
VIDEO_CHUNK_DURATION_SECONDS=15
VIDEO_CONTEXT_MAX_BYTES=20000000
VIDEO_DEFAULT_LANGUAGE=en
TRANSCRIPTION_MODEL=latest_long

# Service Integration (Cloud Run Jobs architecture)
TASK_SERVICE_ACCOUNT=rag-processor-dev@your-gcp-project-id.iam.gserviceaccount.com
QUEUE_HANDLER_SERVICE_NAME=rag-queue-dev

# Frontend Access (Service Account Key - base64 encoded JSON)
GOOGLE_CLOUD_SERVICE_ACCOUNT_KEY=<base64-encoded-service-account-json>

# LlamaIndex Document Processor Configuration
DOCUMENT_PROCESSOR=llamaindex
USE_LLAMAPARSE=false
LLAMAINDEX_FALLBACK_ENABLED=true

# LlamaParse API Key (for PDF processing when USE_LLAMAPARSE=true)
LLAMAPARSE_API_KEY=your-llamaparse-api-key

# Edge Function Configuration (for program ownership validation)
# Required for domain isolation: RAG processor validates program ownership via Edge Function
EDGE_FUNCTION_BASE_URL=https://your-project.supabase.co/functions/v1
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
