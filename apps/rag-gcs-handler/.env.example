# Google Cloud Platform Configuration
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id

# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Cloud Configuration
GOOGLE_CLOUD_REGION=us-central1

# Cloud Tasks Configuration
CLOUD_TASKS_QUEUE_NAME=rag-processing-queue-dev
TASK_PROCESSOR_FUNCTION_URL=https://us-central1-your-gcp-project-id.cloudfunctions.net/rag-task-processor-dev

# Service Account Configuration
GCS_HANDLER_SERVICE_ACCOUNT=rag-gcs-handler-dev@your-gcp-project-id.iam.gserviceaccount.com

# Environment
ENVIRONMENT=development
